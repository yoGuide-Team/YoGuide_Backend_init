# Copy this file to .env and fill in real values before running
# `docker compose up` or `npm run start:dev`. .env is gitignored — it is
# NEVER committed, so a fresh clone of this repo has none of this until you
# create it. See README-DEPLOYMENT.md for the real values to use.

# --- Server ---
PORT=3030

# --- Database ---
# Option A (default in docker-compose.yml): self-hosted Postgres container.
DATABASE_URL="postgresql://yoguide:yoguide@postgres:5432/yoguide?schema=public"
DIRECT_URL="postgresql://yoguide:yoguide@postgres:5432/yoguide?schema=public"
# Option B: shared Supabase project (has the team's existing seeded data —
# guides, chef, cities, etc). If you use this, you can remove/ignore the
# `postgres` service in docker-compose.yml entirely.
#DATABASE_URL="postgresql://<user>:<password>@<supabase-pooler-host>:6543/postgres?pgbouncer=true&sslmode=require"
#DIRECT_URL="postgresql://<user>:<password>@<supabase-pooler-host>:5432/postgres?sslmode=require"

# --- Auth ---
# MUST be a long random string in any real deployment — the value checked
# into the team's working .env today is a placeholder and must be rotated.
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="30d"
FRONTEND_URL="http://localhost:3333"

# --- Google OAuth (verifies Google Sign-In tokens from the Flutter app + web app) ---
GOOGLE_CLIENT_ID=""

# --- Gemini (chatbot) ---
GEMINI_API_KEY=""

# --- Email (OTP, password reset, booking confirmations) ---
RESEND_API_KEY=""
RESEND_FROM_EMAIL="no-reply@yoguide.app"
# Fallback SMTP if Resend's sending domain isn't verified yet.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
