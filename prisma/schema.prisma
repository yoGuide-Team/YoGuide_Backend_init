generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  directUrl    = env("DIRECT_URL")
  relationMode = "prisma"
}

enum UserRole {
  ADMIN
  TOURIST
  GUIDE
  HOTEL_MANAGER
}

enum VisitorType {
  VISITOR
  INVESTOR
  LAYOVER
  EXPERT
}

enum GuideType {
  INDIVIDUAL
  COMPANY
}

enum MediaType {
  IMAGE
  VIDEO
  PDF
}

enum PaymentStatus {
  PENDING
  /// Handed off to the payment provider; awaiting a verified result. The
  /// backend polls the provider for the authoritative outcome — a client
  /// can never move a payment out of this state.
  PROCESSING
  SUCCESSFUL
  FAILED
  CANCELLED
  /// Provider never returned a terminal result before the deadline.
  EXPIRED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CARD
  MOMO
  WALLET
  CASH
}

enum BookingStatus {
  PENDING
  /// Payment handed off to the provider and not yet verified. The slot is
  /// held during this window so a second customer cannot take it.
  PROCESSING
  CONFIRMED
  DECLINED
  CANCELLED
  COMPLETED
  /// Held slot released because payment was never completed in time.
  EXPIRED
}

/// Lifecycle of a provider (guide / tour company / gastronomy) application
/// submitted for admin review. Mirrors the existing hotel apply → verify
/// flow (POST /hotel/apply, POST /admin/hotels/:id/verify).
enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  SUCCESSFUL
  FAILED
  CANCELLED
}

enum Language {
  EN
  FR
  RW
  SW
}

enum IdentityStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                     String              @id @default(uuid())
  fullName               String
  email                  String              @unique
  phone                  String?
  password               String
  nationality            String
  role                   UserRole
  visitorType            VisitorType?
  profileImage           String?
  googleId               String?             @unique
  emailVerified          Boolean             @default(false)
  otpCodeHash            String?
  otpExpiresAt           DateTime?
  passwordResetToken     String?
  passwordResetExpiresAt DateTime?
  /// Single-use account-activation token, stored as a SHA-256 hash — set
  /// when an admin approves a provider application. The plaintext token
  /// only ever exists inside the activation email. No password is ever
  /// emailed; the applicant sets their own via POST /auth/activate.
  activationTokenHash    String?
  activationExpiresAt    DateTime?
  /// True until the user has completed activation and chosen a password.
  /// Login is refused while this is set, so a provisioned-but-unclaimed
  /// account cannot be used.
  mustSetPassword        Boolean             @default(false)
  arrivalDate            DateTime?
  departureDate          DateTime?
  defaultLanguage        Language?
  inAppNotifications     Boolean             @default(true)
  emailNotifications     Boolean             @default(true)
  currentRegionId        String?
  currentRegion          Region?             @relation(fields: [currentRegionId], references: [id])
  trips                  Trip[]
  guideProfile           GuideProfile?
  hotel                  Hotel?
  reviews                Review[]
  bookings               Booking[]
  customPackages         Package[]           @relation("UserCustomPackages")
  wallet                 Wallet?
  walletTransactions     WalletTransaction[]
  threadsAsA             MessageThread[]     @relation("ThreadParticipantA")
  threadsAsB             MessageThread[]     @relation("ThreadParticipantB")
  sentMessages           Message[]
  notifications          Notification[]
  itineraries            Itinerary[]
  eventInterests         EventInterest[]
  esimOrders             EsimOrder[]
  cards                  Card[]
  cardTransactions       CardTransaction[]
  reviewedApplications   GuideApplication[]  @relation("ApplicationReviewer")
  createdFromApplication GuideApplication[]  @relation("ApplicationCreatedUser")
  refundsRequested       Refund[]            @relation("RefundRequestedBy")
  payoutsRequested       Payout[]            @relation("PayoutRequestedBy")
  // KYC gate for yoEcoPay/Wallet — reviewed by an admin, see
  // src/me/me-identity-verification.controller.ts.
  identityStatus          IdentityStatus @default(NONE)
  identityDocUrls         String[]       @default([])
  identityRejectionReason String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([currentRegionId])
}

/// In-app notification feed — currently read-only from the client's
/// perspective (see src/notifications/notifications.controller.ts). Nothing
/// writes rows here yet; other modules producing notifications on real
/// events (booking confirmed, payment received, ...) is a future addition.
model Notification {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  message       String?
  type          String?
  isRead        Boolean  @default(false)
  transactionId String?
  actionLabel   String?
  actionUrl     String?
  createdAt     DateTime @default(now())

  @@index([userId])
}

/// A planned or past visit — users can have many trips.
model Trip {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  regionId      String?
  region        Region?  @relation(fields: [regionId], references: [id])
  label         String?
  arrivalDate   DateTime
  departureDate DateTime
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([regionId])
}

model GuideProfile {
  id            String         @id @default(uuid())
  userId        String         @unique
  user          User           @relation(fields: [userId], references: [id])
  guideType     GuideType
  companyName   String?
  languages     Language[]
  numberOfTours Int            @default(0)
  /// DEPRECATED — superseded by the `chefProfile` relation below. Kept
  /// read-only until existing rows are confirmed backfilled into
  /// ChefProfile, then dropped in a follow-up migration.
  gastronomy    Json?
  /// Admin-controlled verification state. Was previously hardcoded `true`
  /// in the public /guides mappers regardless of any real review — this is
  /// now the single source of truth for that flag.
  isVerified    Boolean        @default(false)
  verifiedAt    DateTime?
  /// Real values for fields the public mappers used to hardcode
  /// (city: 'kigali', bio derived from companyName).
  city          String?
  bio           String?
  /// Guests this provider can serve per day when no per-day override
  /// exists on ProviderAvailability. Enforced by AvailabilityService.
  dailyCapacity Int            @default(1)

  // ── Payout details ─────────────────────────────────────────────
  //
  // Where this provider's money actually goes. Held server-side only:
  // the app never sends a payout destination, it names a provider and the
  // server resolves the number. Before this existed, the one payout route
  // in the system paid a single hardcoded phone number baked into the
  // Cloudflare worker.

  /// Short, public, human-typeable payment code — the same idea as
  /// `Hotel.code`, and what a provider's QR encodes. Safe to display;
  /// resolving it reveals only a display name and a masked number.
  paymentCode      String?  @unique
  /// Mobile-money number that receives payouts, in local format. Never
  /// returned to a client in full — see maskMsisdn().
  payoutMsisdn     String?
  /// Account-holder name the telecom expects for the payout.
  payoutName       String?
  /// XentriPay telecom provider id (e.g. MTN / Airtel). Null falls back to
  /// PAYOUT_DEFAULT_TELECOM_ID.
  payoutTelecomId  String?
  /// Set once an admin has checked the payout number belongs to this
  /// provider. Payouts are refused unless this is true, so a typo or a
  /// hijacked profile cannot silently redirect money.
  payoutVerified   Boolean  @default(false)

  payouts       Payout[]
  chefProfile   ChefProfile?
  experiences   GuideExperience[]
  reviews       Review[]
  vehicles      GuideVehicle[]
  bookings      Booking[]
  packages      Package[]              @relation("PackageOwner")
  tourTypes     TourType[]             @relation("TourTypeOwner")
  availability  ProviderAvailability[]
  blockedDates  AvailabilityException[]
  application   GuideApplication?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt

  @@index([isVerified])
}

/// A provider's recurring weekly availability. One row per weekday the
/// provider works; a weekday with no row is treated as unavailable. Kept
/// deliberately simple (weekday + open/close + capacity) rather than a
/// full calendar — AvailabilityException handles one-off deviations.
model ProviderAvailability {
  id         String       @id @default(uuid())
  guideId    String
  guide      GuideProfile @relation(fields: [guideId], references: [id], onDelete: Cascade)
  /// 0 = Sunday … 6 = Saturday, matching JavaScript's Date.getDay().
  weekday    Int
  /// Local wall-clock times as "HH:mm". Null start/end means "all day".
  startTime  String?
  endTime    String?
  /// Guests bookable on this weekday. Null falls back to
  /// GuideProfile.dailyCapacity.
  capacity   Int?
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([guideId, weekday])
  @@index([guideId])
}

/// A one-off override for a specific date — either a blackout (holiday,
/// already-committed trip) or extra capacity. Takes precedence over the
/// weekly ProviderAvailability row for that date.
model AvailabilityException {
  id        String       @id @default(uuid())
  guideId   String
  guide     GuideProfile @relation(fields: [guideId], references: [id], onDelete: Cascade)
  /// Date only, stored at UTC midnight — compare with startOfUtcDay().
  date      DateTime
  /// true = the provider is unavailable all day, whatever the weekly rule says.
  isBlocked Boolean      @default(true)
  /// When isBlocked is false, overrides capacity for this date only.
  capacity  Int?
  reason    String?
  createdAt DateTime     @default(now())

  @@unique([guideId, date])
  @@index([guideId])
  @@index([date])
}

/// A provider's application to join the platform, reviewed by an admin.
/// Mirrors the existing hotel apply → verify flow. On approval the backend
/// provisions the User + GuideProfile and emails a single-use activation
/// link — it never emails a password (see AccountProvisioningService).
model GuideApplication {
  id             String            @id @default(uuid())
  /// Applicant contact details. Deliberately not a User relation: an
  /// applicant has no account until an admin approves them.
  fullName       String
  email          String
  phone          String?
  nationality    String?
  guideType      GuideType         @default(INDIVIDUAL)
  companyName    String?
  city           String?
  bio            String?
  languages      Language[]        @default([])
  /// Uploaded licence / ID / certification URLs from POST /files/sign-upload.
  documentUrls   String[]          @default([])
  /// Set when the applicant intends to offer gastronomy experiences, so
  /// approval can provision the ChefProfile alongside the GuideProfile.
  wantsGastronomy Boolean          @default(false)
  status         ApplicationStatus @default(PENDING)
  reviewedById   String?
  reviewedBy     User?             @relation("ApplicationReviewer", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  rejectionReason String?
  /// Populated on approval — links the application to what it created.
  createdUserId  String?
  createdUser    User?             @relation("ApplicationCreatedUser", fields: [createdUserId], references: [id])
  guideId        String?           @unique
  guide          GuideProfile?     @relation(fields: [guideId], references: [id])
  /// Approval-email audit trail (Phase 14 requires recording delivery).
  approvalEmailSentAt DateTime?
  approvalEmailStatus String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([email, status])
  @@index([status])
  @@index([reviewedById])
  @@index([createdUserId])
}

/// A showcased experience on a guide's profile (any guide type, not just
/// chefs) — pure marketing/trust-building gallery, no booking linkage.
model GuideExperience {
  id          String                 @id @default(uuid())
  guideId     String
  guide       GuideProfile           @relation(fields: [guideId], references: [id], onDelete: Cascade)
  title       String
  description String?
  sortOrder   Int                    @default(0)
  media       GuideExperienceMedia[]
  createdAt   DateTime               @default(now())

  @@index([guideId])
}

model GuideExperienceMedia {
  id           String          @id @default(uuid())
  experienceId String
  experience   GuideExperience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  url          String
  type         MediaType
  sortOrder    Int             @default(0)

  @@index([experienceId])
}

/// Admin-managed gastronomy experience category (e.g. "Homestyle",
/// "Farm-to-table") — the top-level filter shown on the app's gastronomy
/// category picker.
model GastronomyCategory {
  id          String        @id @default(uuid())
  name        String
  description String?
  /// A string tag the frontend maps to an IconData, e.g. "ramen_dining".
  iconKey     String?
  sortOrder   Int           @default(0)
  isActive    Boolean       @default(true)
  chefs       ChefProfile[]
  createdAt   DateTime      @default(now())
}

/// Chef/dining-experience profile — one per GuideProfile that hosts
/// gastronomy experiences, self-managed by the guide. A GuideProfile with
/// no ChefProfile is a regular tour guide.
model ChefProfile {
  id                 String             @id @default(uuid())
  guideId            String             @unique
  guide              GuideProfile       @relation(fields: [guideId], references: [id])
  categoryId         String
  category           GastronomyCategory @relation(fields: [categoryId], references: [id])
  restaurantName     String?
  experienceName     String?
  area               String?
  tags               String[]           @default([])
  introVideoUrl      String?
  storyTitle         String?
  storyDurationLabel String?
  storyText          String?
  courses            ChefCourse[]
  priceTiers         ChefPriceTier[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([categoryId])
}

/// A menu item a chef offers — content only, no price (price is set per
/// party-size bracket on ChefPriceTier, not per course).
model ChefCourse {
  id             String            @id @default(uuid())
  chefId         String
  chef           ChefProfile       @relation(fields: [chefId], references: [id])
  name           String
  description    String?
  imageUrl       String?
  sortOrder      Int               @default(0)
  bookingCourses BookingCourse[]
  media          ChefCourseMedia[]

  @@index([chefId])
}

model ChefCourseMedia {
  id        String     @id @default(uuid())
  courseId  String
  course    ChefCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  url       String
  type      MediaType
  sortOrder Int        @default(0)

  @@index([courseId])
}

/// Per-person price for a party-size bracket, e.g. minPartySize=1,
/// maxPartySize=2 → "1-2 people: $50/person". maxPartySize=null means
/// "and up" (the top-open bracket). Brackets must not overlap — validated
/// at the API layer, not the DB, matching this codebase's existing style
/// (see ensureRegion/ensureExists helpers).
model ChefPriceTier {
  id                String      @id @default(uuid())
  chefId            String
  chef              ChefProfile @relation(fields: [chefId], references: [id])
  minPartySize      Int
  maxPartySize      Int?
  pricePerPersonUsd Decimal     @db.Decimal(12, 2)
  sortOrder         Int         @default(0)

  @@index([chefId])
}

model Region {
  id        String     @id @default(uuid())
  name      String
  users     User[]
  trips     Trip[]
  tourTypes TourType[]
}

model TourType {
  id       String    @id @default(uuid())
  regionId String
  region   Region    @relation(fields: [regionId], references: [id])
  name     String
  /// The provider that created this tour type. NULL means platform-owned
  /// (admin-managed) — that is what every row created before provider
  /// ownership existed is, and only admins may edit those. A non-null
  /// owner may be edited and deleted only by that provider or an admin.
  /// See ProviderOwnershipService.assertCanMutateTourType().
  ownerId  String?
  owner    GuideProfile? @relation("TourTypeOwner", fields: [ownerId], references: [id])
  packages Package[]

  @@index([regionId])
  @@index([ownerId])
}

model Package {
  id            String         @id @default(uuid())
  tourTypeId    String
  tourType      TourType       @relation(fields: [tourTypeId], references: [id])
  name          String
  description   String
  durationHours Int
  price         Decimal        @db.Decimal(12, 2)
  /// A custom package is composed by a tourist from individual tours and is
  /// only visible to its creator — never in the public catalog.
  isCustom      Boolean        @default(false)
  createdById   String?
  createdBy     User?          @relation("UserCustomPackages", fields: [createdById], references: [id])
  /// The provider that owns this package. NULL means platform-owned
  /// (admin-managed) — the state every pre-existing row is backfilled to.
  /// Distinct from `createdById`, which is the *tourist* who composed a
  /// custom package; the two are never both set.
  ownerId       String?
  owner         GuideProfile?  @relation("PackageOwner", fields: [ownerId], references: [id])
  /// Set false to withdraw a package from the public catalog without
  /// deleting it (and without orphaning historical bookings).
  isActive      Boolean        @default(true)
  /// Maximum guests per booking of this package. Null = no package-level
  /// cap; the provider's daily capacity still applies.
  maxGuests     Int?
  tours         PackageTour[]
  media         PackageMedia[]
  reviews       Review[]
  bookings      Booking[]
  createdAt     DateTime       @default(now())

  @@index([tourTypeId])
  @@index([createdById])
  @@index([ownerId])
}

model PackageTour {
  id          String  @id @default(uuid())
  packageId   String
  package     Package @relation(fields: [packageId], references: [id])
  title       String
  description String
  duration    Int
  price       Decimal @db.Decimal(12, 2)

  @@index([packageId])
}

model PackageMedia {
  id        String    @id @default(uuid())
  packageId String
  package   Package   @relation(fields: [packageId], references: [id])
  url       String
  type      MediaType

  @@index([packageId])
}

model Vehicle {
  id           String         @id @default(uuid())
  name         String
  icon         String?
  seats        Int
  pricePerHour Decimal        @db.Decimal(12, 2)
  pricePerDay  Decimal        @db.Decimal(12, 2)
  guides       GuideVehicle[]
  bookings     Booking[]
}

model GuideVehicle {
  guideId   String
  vehicleId String
  guide     GuideProfile @relation(fields: [guideId], references: [id])
  vehicle   Vehicle      @relation(fields: [vehicleId], references: [id])

  @@id([guideId, vehicleId])
  @@index([vehicleId])
}

model Review {
  id         String        @id @default(uuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id])
  guideId    String?
  guide      GuideProfile? @relation(fields: [guideId], references: [id])
  packageId  String?
  package    Package?      @relation(fields: [packageId], references: [id])
  /// Links this review to the completed booking it was left for — nullable
  /// since older admin-created reviews predate this field. Unique so a
  /// booking can only ever have one review.
  bookingId  String?       @unique
  booking    Booking?      @relation(fields: [bookingId], references: [id])
  message    String?
  starRating Int
  createdAt  DateTime      @default(now())

  @@index([userId])
  @@index([guideId])
  @@index([packageId])
  @@index([bookingId])
}

model Booking {
  id              String              @id @default(uuid())
  userId          String
  user            User                @relation(fields: [userId], references: [id])
  packageId       String?
  package         Package?            @relation(fields: [packageId], references: [id])
  vehicleId       String?
  vehicle         Vehicle?            @relation(fields: [vehicleId], references: [id])
  guideId         String?
  guide           GuideProfile?       @relation(fields: [guideId], references: [id])
  hotelId         String?
  hotel           Hotel?               @relation(fields: [hotelId], references: [id])
  scheduleDate    DateTime
  /// Requested start time as local wall-clock "HH:mm", validated against
  /// the provider's ProviderAvailability window. Null for legacy rows and
  /// for all-day experiences.
  startTime       String?
  pickupLocation  String?
  /// Gastronomy-only: number of diners. Null for tour/vehicle bookings.
  partySize       Int?
  /// Guests on this booking for capacity purposes, for every booking type.
  /// Gastronomy bookings set this to the same value as partySize; tour
  /// bookings previously had nowhere to record a guest count at all.
  guests          Int                 @default(1)
  /// Human-readable booking reference shown on the ticket, e.g. "YG-4KQ2P8B1".
  /// Generated server-side with generateShortCode(); never client-supplied.
  reference       String?             @unique
  selectedCourses BookingCourse[]
  totalDue        Decimal             @db.Decimal(12, 2)
  currency        String              @default("USD")
  status          BookingStatus       @default(PENDING)
  /// While a booking is PENDING/PROCESSING it holds its capacity slot until
  /// this moment; a lapsed hold is swept to EXPIRED and the slot freed.
  holdExpiresAt   DateTime?
  paymentMethod   PaymentMethod?
  notes           String?
  cancelledAt     DateTime?
  cancellationReason String?
  payment         Payment?
  refunds         Refund[]
  review          Review?
  walletEntries   WalletTransaction[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @default(now()) @updatedAt

  @@index([userId])
  @@index([packageId])
  @@index([vehicleId])
  @@index([guideId])
  @@index([hotelId])
  /// Backs the availability/conflict query, which counts committed guests
  /// for one provider on one date.
  @@index([guideId, scheduleDate, status])
  @@index([status, holdExpiresAt])
}

/// Which menu items a diner picked for a gastronomy booking. Mirrors the
/// existing GuideVehicle composite-key join-table pattern.
model BookingCourse {
  bookingId String
  courseId  String
  booking   Booking    @relation(fields: [bookingId], references: [id])
  course    ChefCourse @relation(fields: [courseId], references: [id])

  @@id([bookingId, courseId])
  @@index([courseId])
}

/// Per-user balance kept in integer cents. A wallet is created lazily on
/// first read for a user that doesn't have one.
model Wallet {
  id           String              @id @default(cuid())
  userId       String              @unique
  balanceCents Int                 @default(0)
  currency     String              @default("USD")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
}

model WalletTransaction {
  id             String   @id @default(cuid())
  walletId       String?
  kind           String?
  amountCents    Int?
  currency       String   @default("USD")
  bookingId      String?
  externalRef    String?
  notes          String?
  createdAt      DateTime @default(now())
  cardToken      String?
  method         String?
  rwfAmount      Float?
  sourceAmount   Float?
  sourceCurrency String?
  status         String   @default("pending")
  userId         String?
  wallet         Wallet?  @relation(fields: [walletId], references: [id], onDelete: Cascade)
  booking        Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user           User?    @relation(fields: [userId], references: [id])

  @@index([walletId])
  @@index([bookingId])
  @@index([userId])
}

model Hotel {
  id           String       @id @default(uuid())
  managerId    String       @unique
  manager      User         @relation(fields: [managerId], references: [id])
  name         String
  description  String?
  city         String?
  address      String?
  amenities    String[]     @default([])
  checkInTime  String?
  checkOutTime String?
  contact      String?
  phone        String?
  website      String?
  isVerified   Boolean      @default(false)
  /// Short public code for the corporate-card payment flow
  /// (POST /payments/initiate) — distinct from the internal uuid id.
  /// Nullable only because it was added after some hotels already existed;
  /// every hotel created going forward always gets one.
  code             String?           @unique
  rooms            HotelRoom[]
  bookings         Booking[]
  cardTransactions CardTransaction[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([managerId])
}

model HotelRoom {
  id           String  @id @default(uuid())
  hotelId      String
  hotel        Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name         String
  totalRooms   Int     @default(0)
  nightlyRateCents Int @default(0)
  currency     String  @default("USD")
  amenities    String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([hotelId])
}

/// One payment attempt against a booking. `status` is written ONLY by the
/// server after verifying the outcome with the payment provider — see
/// PaymentsService.verify(). No client-supplied status is ever trusted;
/// the old POST /bookings/:id/payment route that accepted one is gone.
model Payment {
  id             String        @id @default(uuid())
  bookingId      String        @unique
  booking        Booking       @relation(fields: [bookingId], references: [id])
  amount         Decimal       @db.Decimal(12, 2)
  currency       String        @default("USD")
  status         PaymentStatus @default(PENDING)
  paymentMethod  PaymentMethod
  transactionRef String?
  /// Which provider settled this — "xentripay" via the yoEcoPay worker,
  /// "wallet" for internal balance, "cash" for pay-on-arrival.
  provider       String?
  /// The provider's own session/transaction id, used to poll for the
  /// authoritative result. Unique so one provider session can never be
  /// attached to two bookings.
  providerRef    String?       @unique
  /// Verbatim last status string from the provider, kept for support and
  /// reconciliation even when it maps onto the same PaymentStatus.
  providerStatus String?
  /// Caller-supplied key making payment initiation safe to retry — a
  /// repeat with the same key returns the original attempt instead of
  /// charging again.
  idempotencyKey String?       @unique
  /// Set the moment the server confirmed the outcome with the provider.
  /// A SUCCESSFUL payment with a null verifiedAt is a bug, not a payment.
  verifiedAt     DateTime?
  /// Amount already refunded, in the same currency. Drives
  /// PARTIALLY_REFUNDED vs REFUNDED.
  refundedAmount Decimal       @default(0) @db.Decimal(12, 2)
  failureReason  String?
  attempts       PaymentAttempt[]
  refunds        Refund[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt

  @@index([status])
  @@index([provider])
}

/// Append-only audit trail: every provider interaction on a payment, kept
/// so a disputed charge can be reconstructed. Never updated, only inserted.
model PaymentAttempt {
  id           String   @id @default(uuid())
  paymentId    String
  payment      Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  /// "initiate" | "verify" | "webhook" | "refund"
  action       String
  providerRef  String?
  /// Provider status string as received.
  resultStatus String?
  httpStatus   Int?
  /// Provider response body, truncated. Must never contain card data — the
  /// provider is not sent any, and only its JSON reply is stored.
  responseBody String?
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([paymentId])
  @@index([createdAt])
}

/// Money sent *out* to a provider — a guide, chef, tour company or artisan.
///
/// Every payout is a row here before the provider is contacted, so there is
/// no such thing as an untracked disbursement. The destination number is
/// resolved server-side from the provider's profile and recorded as it was
/// at the time, so changing a profile later cannot rewrite history.
///
/// This replaces a flow where the mobile app called the payout worker
/// directly with a hardcoded product id, and the worker paid a phone number
/// baked into its own source.
model Payout {
  id             String       @id @default(uuid())
  guideId        String
  guide          GuideProfile @relation(fields: [guideId], references: [id])
  /// Optional link to what is being paid for.
  bookingId      String?
  amount         Decimal      @db.Decimal(12, 2)
  currency       String       @default("RWF")
  status         PayoutStatus @default(PENDING)
  /// Destination as used at send time. Stored so a later profile edit does
  /// not retroactively change where a past payout appears to have gone.
  destinationMsisdn String
  destinationName   String?
  /// Our own reference, sent to the provider and used to poll status.
  reference      String       @unique
  providerRef    String?
  providerStatus String?
  failureReason  String?
  /// Who authorised it. Null for system-initiated provider settlements.
  requestedById  String?
  requestedBy    User?        @relation("PayoutRequestedBy", fields: [requestedById], references: [id])

  // ── Collection leg ─────────────────────────────────────────────
  //
  // When a traveller pays a provider directly (scanning their code), the
  // money has to be collected from the payer before it can be sent on.
  // These fields track that first leg. They are null for admin-initiated
  // settlements, where yoGuide already holds the funds.
  //
  // Keeping both legs on one row is what stops the old failure mode: the
  // app used to fire a payout with no corresponding collection at all.

  /// The traveller who paid.
  payerUserId       String?
  /// Provider session id for the collection, polled for the real outcome.
  collectionRef     String?  @unique
  /// Verbatim provider status for the collection leg.
  collectionStatus  String?
  /// Set only once the collection was verified with the provider. A payout
  /// is never sent before this is non-null.
  collectedAt       DateTime?
  note           String?
  processedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt

  @@index([guideId])
  @@index([status])
  @@index([bookingId])
  @@index([requestedById])
  @@index([payerUserId])
}

/// A refund against a booking's payment. Eligibility and amount are decided
/// server-side by RefundService from the cancellation policy — the client
/// never supplies an amount or asserts eligibility.
model Refund {
  id             String       @id @default(uuid())
  bookingId      String
  booking        Booking      @relation(fields: [bookingId], references: [id])
  paymentId      String?
  payment        Payment?     @relation(fields: [paymentId], references: [id])
  amount         Decimal      @db.Decimal(12, 2)
  currency       String       @default("USD")
  status         RefundStatus @default(PENDING)
  /// Which policy rule produced this amount, e.g. "full_over_72h",
  /// "half_24_to_72h", "none_under_24h", "provider_declined".
  policyRule     String?
  reason         String?
  requestedById  String?
  requestedBy    User?        @relation("RefundRequestedBy", fields: [requestedById], references: [id])
  providerRef    String?
  providerStatus String?
  processedAt    DateTime?
  failureReason  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt

  @@index([bookingId])
  @@index([paymentId])
  @@index([status])
  @@index([requestedById])
}

/// A 1:1 conversation between two users (tourist <-> guide today, but not
/// role-restricted). participantA/B order is whichever side created the
/// thread first — callers must check both fields, never assume an order.
model MessageThread {
  id           String    @id @default(uuid())
  participantA String
  userA        User      @relation("ThreadParticipantA", fields: [participantA], references: [id])
  participantB String
  userB        User      @relation("ThreadParticipantB", fields: [participantB], references: [id])
  messages     Message[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([participantA])
  @@index([participantB])
}

model Message {
  id        String        @id @default(uuid())
  threadId  String
  thread    MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User          @relation(fields: [senderId], references: [id])
  body      String
  createdAt DateTime      @default(now())

  @@index([threadId])
}

/// A user's saved trip plan — src/itineraries/itineraries.controller.ts.
/// Owner-scoped: every route resolves through the caller's own rows.
model Itinerary {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  isPublic    Boolean         @default(false)
  coverImage  String?
  items       ItineraryItem[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId])
}

model ItineraryItem {
  id          String    @id @default(uuid())
  itineraryId String
  itinerary   Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  ordinal     Int
  placeId     String?
  notes       String?
  scheduledAt DateTime?

  @@index([itineraryId])
}

/// Public city directory backing the onboarding "what's on" step — GET
/// /cities/:slug/events (src/cities/cities.controller.ts). No seed data:
/// empty until a real events source is wired up, same convention as the
/// hotels feature's placeholder-free approach.
model City {
  id     String  @id @default(uuid())
  slug   String  @unique
  name   String
  events Event[]
}

model Event {
  id         String          @id @default(uuid())
  cityId     String
  city       City            @relation(fields: [cityId], references: [id], onDelete: Cascade)
  title      String
  venue      String?
  priceLabel String?
  startsAt   DateTime
  tags       String[]        @default([])
  interests  EventInterest[]

  @@index([cityId])
}

/// POST /me/event-interests (src/me/event-interests.controller.ts).
model EventInterest {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId         String
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  reminderEnabled Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@unique([userId, eventId])
  @@index([eventId])
}

/// POST /orders/esim (src/esim/esim-orders.controller.ts) — recorded as a
/// mock order, same honesty convention as WalletService.topUp()'s "mock
/// top-up" labeling. No real eSIM provider is wired up.
model EsimOrder {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bundleId       String
  deliveryEmail  String
  status         String   @default("mock_confirmed")
  createdAt      DateTime @default(now())

  @@index([userId])
}

enum CardStatus {
  ACTIVE
  FROZEN
  CANCELLED
}

enum CardTransactionStatus {
  PENDING
  SETTLED
  DISPUTED
  FAILED
}

/// Internally-issued corporate expense card — NOT a real bank card. No full
/// card number is ever stored or returned, only `last4` (display purposes)
/// and a bcrypt hash of the PIN (`pinHash`). Issued by an admin via
/// POST /admin/cards, never self-issued (src/payments/cards.controller.ts,
/// src/admin/catalog/admin-cards.controller.ts).
model Card {
  id           String            @id @default(uuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String            @default("virtual")
  last4        String
  pinHash      String
  limitCents   Int               @default(0)
  spentCents   Int               @default(0)
  currency     String            @default("USD")
  status       CardStatus        @default(ACTIVE)
  organization String?
  transactions CardTransaction[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([userId])
}

/// One corporate-card charge — src/payments/payments.controller.ts. `hotel`
/// is the "service provider" side (POST /payments/initiate resolves a
/// Hotel by its short `code`); no separate ServiceProvider model exists,
/// since guides/hotels/gastronomy already cover that ground.
model CardTransaction {
  id          String                 @id @default(uuid())
  cardId      String
  card        Card                   @relation(fields: [cardId], references: [id])
  userId      String
  user        User                   @relation(fields: [userId], references: [id])
  hotelId     String?
  hotel       Hotel?                 @relation(fields: [hotelId], references: [id])
  amountCents Int
  currency    String                 @default("USD")
  status      CardTransactionStatus  @default(SETTLED)
  title       String?
  details     String?
  reference   String                 @unique
  createdAt   DateTime               @default(now())

  @@index([userId])
  @@index([hotelId])
  @@index([cardId])
}
