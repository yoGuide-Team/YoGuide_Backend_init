generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  directUrl    = env("DIRECT_URL")
  relationMode = "prisma"
}

model User {
  id                     String              @id @default(uuid())
  fullName               String
  email                  String              @unique
  phone                  String?
  password               String
  nationality            String
  role                   UserRole
  visitorType            VisitorType?
  profileImage           String?
  arrivalDate            DateTime?
  departureDate          DateTime?
  defaultLanguage        Language?
  inAppNotifications     Boolean             @default(true)
  emailNotifications     Boolean             @default(true)
  currentRegionId        String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  googleId               String?             @unique
  emailVerified          Boolean             @default(false)
  otpCodeHash            String?
  otpExpiresAt           DateTime?
  passwordResetToken     String?
  passwordResetExpiresAt DateTime?
  currentRegion          Region?             @relation(fields: [currentRegionId], references: [id])
  trips                  Trip[]
  guideProfile           GuideProfile?
  hotel                  Hotel?
  reviews                Review[]
  bookings               Booking[]
  customPackages         Package[]           @relation("UserCustomPackages")
  wallet                 Wallet?
  walletTransactions     WalletTransaction[]

  @@index([currentRegionId])
}

/// A planned or past visit — users can have many trips.
model Trip {
  id            String   @id @default(uuid())
  userId        String
  regionId      String?
  label         String?
  arrivalDate   DateTime
  departureDate DateTime
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  region        Region?  @relation(fields: [regionId], references: [id])

  @@index([userId])
  @@index([regionId])
}

model GuideProfile {
  id            String            @id @default(uuid())
  userId        String            @unique
  guideType     GuideType
  companyName   String?
  numberOfTours Int               @default(0)
  languages     Language[]
  /// DEPRECATED — superseded by the `chefProfile` relation below. Kept
  /// read-only until existing rows are confirmed backfilled into
  /// ChefProfile, then dropped in a follow-up migration.
  gastronomy    Json?
  user          User              @relation(fields: [userId], references: [id])
  chefProfile   ChefProfile?
  experiences   GuideExperience[]
  reviews       Review[]
  vehicles      GuideVehicle[]
  bookings      Booking[]
}

/// A showcased experience on a guide's profile (any guide type, not just
/// chefs) — pure marketing/trust-building gallery, no booking linkage.
model GuideExperience {
  id          String                 @id @default(uuid())
  guideId     String
  title       String
  description String?
  sortOrder   Int                    @default(0)
  createdAt   DateTime               @default(now())
  guide       GuideProfile           @relation(fields: [guideId], references: [id], onDelete: Cascade)
  media       GuideExperienceMedia[]

  @@index([guideId])
}

model GuideExperienceMedia {
  id           String          @id @default(uuid())
  experienceId String
  url          String
  type         MediaType
  sortOrder    Int             @default(0)
  experience   GuideExperience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@index([experienceId])
}

/// Admin-managed gastronomy experience category (e.g. "Homestyle",
/// "Farm-to-table") — the top-level filter shown on the app's gastronomy
/// category picker.
model GastronomyCategory {
  id          String        @id @default(uuid())
  name        String
  description String?
  /// A string tag the frontend maps to an IconData, e.g. "ramen_dining".
  iconKey     String?
  sortOrder   Int           @default(0)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  chefs       ChefProfile[]
}

/// Chef/dining-experience profile — one per GuideProfile that hosts
/// gastronomy experiences, self-managed by the guide. A GuideProfile with
/// no ChefProfile is a regular tour guide.
model ChefProfile {
  id                 String             @id @default(uuid())
  guideId            String             @unique
  categoryId         String
  restaurantName     String?
  experienceName     String?
  area               String?
  tags               String[]           @default([])
  introVideoUrl      String?
  storyTitle         String?
  storyDurationLabel String?
  storyText          String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  guide              GuideProfile       @relation(fields: [guideId], references: [id])
  category           GastronomyCategory @relation(fields: [categoryId], references: [id])
  courses            ChefCourse[]
  priceTiers         ChefPriceTier[]

  @@index([categoryId])
}

/// A menu item a chef offers — content only, no price (price is set per
/// party-size bracket on ChefPriceTier, not per course).
model ChefCourse {
  id             String            @id @default(uuid())
  chefId         String
  name           String
  description    String?
  sortOrder      Int               @default(0)
  imageUrl       String?
  chef           ChefProfile       @relation(fields: [chefId], references: [id])
  bookingCourses BookingCourse[]
  media          ChefCourseMedia[]

  @@index([chefId])
}

model ChefCourseMedia {
  id        String     @id @default(uuid())
  courseId  String
  url       String
  type      MediaType
  sortOrder Int        @default(0)
  course    ChefCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

/// Per-person price for a party-size bracket, e.g. minPartySize=1,
/// maxPartySize=2 → "1-2 people: $50/person". maxPartySize=null means
/// "and up" (the top-open bracket). Brackets must not overlap — validated
/// at the API layer, not the DB, matching this codebase's existing style
/// (see ensureRegion/ensureExists helpers).
model ChefPriceTier {
  id                String      @id @default(uuid())
  chefId            String
  minPartySize      Int
  maxPartySize      Int?
  pricePerPersonUsd Decimal     @db.Decimal(12, 2)
  sortOrder         Int         @default(0)
  chef              ChefProfile @relation(fields: [chefId], references: [id])

  @@index([chefId])
}

model Region {
  id        String     @id @default(uuid())
  name      String
  users     User[]
  trips     Trip[]
  tourTypes TourType[]
}

model TourType {
  id       String    @id @default(uuid())
  regionId String
  name     String
  region   Region    @relation(fields: [regionId], references: [id])
  packages Package[]

  @@index([regionId])
}

model Package {
  id            String         @id @default(uuid())
  tourTypeId    String
  name          String
  description   String
  durationHours Int
  price         Decimal        @db.Decimal(12, 2)
  createdAt     DateTime       @default(now())
  createdById   String?
  /// A custom package is composed by a tourist from individual tours and is
  /// only visible to its creator — never in the public catalog.
  isCustom      Boolean        @default(false)
  tourType      TourType       @relation(fields: [tourTypeId], references: [id])
  createdBy     User?          @relation("UserCustomPackages", fields: [createdById], references: [id])
  tours         PackageTour[]
  media         PackageMedia[]
  reviews       Review[]
  bookings      Booking[]

  @@index([tourTypeId])
  @@index([createdById])
}

model PackageTour {
  id          String  @id @default(uuid())
  packageId   String
  title       String
  description String
  duration    Int
  price       Decimal @db.Decimal(12, 2)
  package     Package @relation(fields: [packageId], references: [id])

  @@index([packageId])
}

model PackageMedia {
  id        String    @id @default(uuid())
  packageId String
  url       String
  type      MediaType
  package   Package   @relation(fields: [packageId], references: [id])

  @@index([packageId])
}

model Vehicle {
  id           String         @id @default(uuid())
  name         String
  icon         String?
  seats        Int
  pricePerHour Decimal        @db.Decimal(12, 2)
  pricePerDay  Decimal        @db.Decimal(12, 2)
  guides       GuideVehicle[]
  bookings     Booking[]
}

model GuideVehicle {
  guideId   String
  vehicleId String
  guide     GuideProfile @relation(fields: [guideId], references: [id])
  vehicle   Vehicle      @relation(fields: [vehicleId], references: [id])

  @@id([guideId, vehicleId])
  @@index([vehicleId])
}

model Review {
  id         String        @id @default(uuid())
  userId     String
  guideId    String?
  packageId  String?
  message    String?
  starRating Int
  createdAt  DateTime      @default(now())
  /// Links this review to the completed booking it was left for — nullable
  /// since older admin-created reviews predate this field. Unique so a
  /// booking can only ever have one review.
  bookingId  String?       @unique
  user       User          @relation(fields: [userId], references: [id])
  guide      GuideProfile? @relation(fields: [guideId], references: [id])
  package    Package?      @relation(fields: [packageId], references: [id])
  booking    Booking?      @relation(fields: [bookingId], references: [id])

  @@index([userId])
  @@index([guideId])
  @@index([packageId])
  @@index([bookingId])
}

model Booking {
  id              String              @id @default(uuid())
  userId          String
  packageId       String?
  vehicleId       String?
  guideId         String?
  scheduleDate    DateTime
  pickupLocation  String?
  totalDue        Decimal             @db.Decimal(12, 2)
  createdAt       DateTime            @default(now())
  notes           String?
  paymentMethod   PaymentMethod?
  status          BookingStatus       @default(PENDING)
  /// Gastronomy-only: number of diners. Null for tour/vehicle bookings.
  partySize       Int?
  hotelId         String?
  user            User                @relation(fields: [userId], references: [id])
  package         Package?            @relation(fields: [packageId], references: [id])
  vehicle         Vehicle?            @relation(fields: [vehicleId], references: [id])
  guide           GuideProfile?       @relation(fields: [guideId], references: [id])
  hotel           Hotel?              @relation(fields: [hotelId], references: [id])
  selectedCourses BookingCourse[]
  payment         Payment?
  review          Review?
  walletEntries   WalletTransaction[]

  @@index([userId])
  @@index([packageId])
  @@index([vehicleId])
  @@index([guideId])
}

/// Which menu items a diner picked for a gastronomy booking. Mirrors the
/// existing GuideVehicle composite-key join-table pattern.
model BookingCourse {
  bookingId String
  courseId  String
  booking   Booking    @relation(fields: [bookingId], references: [id])
  course    ChefCourse @relation(fields: [courseId], references: [id])

  @@id([bookingId, courseId])
  @@index([courseId])
}

/// Per-user balance kept in integer cents. A wallet is created lazily on
/// first read for a user that doesn't have one.
model Wallet {
  id           String              @id @default(cuid())
  userId       String              @unique
  balanceCents Int                 @default(0)
  currency     String              @default("USD")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
}

model WalletTransaction {
  id             String   @id @default(cuid())
  walletId       String?
  kind           String?
  amountCents    Int?
  currency       String   @default("USD")
  bookingId      String?
  externalRef    String?
  notes          String?
  createdAt      DateTime @default(now())
  cardToken      String?
  method         String?
  rwfAmount      Float?
  sourceAmount   Float?
  sourceCurrency String?
  status         String   @default("pending")
  userId         String?
  wallet         Wallet?  @relation(fields: [walletId], references: [id], onDelete: Cascade)
  booking        Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user           User?    @relation(fields: [userId], references: [id])

  @@index([walletId])
  @@index([bookingId])
  @@index([userId])
}

model Hotel {
  id           String      @id @default(uuid())
  managerId    String      @unique
  name         String
  description  String?
  city         String?
  address      String?
  amenities    String[]    @default([])
  checkInTime  String?
  checkOutTime String?
  contact      String?
  phone        String?
  website      String?
  isVerified   Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  manager      User        @relation(fields: [managerId], references: [id])
  rooms        HotelRoom[]
  bookings     Booking[]

  @@index([managerId])
}

model HotelRoom {
  id               String   @id @default(uuid())
  hotelId          String
  name             String
  totalRooms       Int      @default(0)
  nightlyRateCents Int      @default(0)
  currency         String   @default("USD")
  amenities        String[] @default([])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  hotel            Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId])
}

model Payment {
  id                String        @id @default(uuid())
  bookingId         String        @unique
  amount            Decimal       @db.Decimal(12, 2)
  status            PaymentStatus
  paymentMethod     PaymentMethod
  transactionRef    String?
  createdAt         DateTime      @default(now())
  platformFeeAmount Decimal?      @db.Decimal(12, 2)
  booking           Booking       @relation(fields: [bookingId], references: [id])
}

enum UserRole {
  ADMIN
  TOURIST
  GUIDE
  HOTEL_MANAGER
}

enum VisitorType {
  VISITOR
  INVESTOR
  LAYOVER
  EXPERT
}

enum GuideType {
  INDIVIDUAL
  COMPANY
}

enum MediaType {
  IMAGE
  VIDEO
  PDF
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
}

enum PaymentMethod {
  CARD
  MOMO
  WALLET
  CASH
}

enum BookingStatus {
  PENDING
  CONFIRMED
  DECLINED
  CANCELLED
  COMPLETED
}

enum Language {
  EN
  FR
  RW
  SW
}
model MessageThread {
  id            String          @id @default(uuid())
  participantA  String
  participantB  String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  messages      ThreadMessage[]

  @@unique([participantA, participantB])
}

model ThreadMessage {
  id        String        @id @default(uuid())
  threadId  String
  thread    MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId  String
  body      String
  createdAt DateTime      @default(now())
}
