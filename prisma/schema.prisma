generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  directUrl    = env("DIRECT_URL")
  relationMode = "prisma"
}

enum UserRole {
  ADMIN
  TOURIST
  GUIDE
}

enum VisitorType {
  VISITOR
  INVESTOR
  LAYOVER
  EXPERT
}

enum GuideType {
  INDIVIDUAL
  COMPANY
}

enum MediaType {
  IMAGE
  VIDEO
  PDF
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
}

enum PaymentMethod {
  CARD
  MOMO
}

model User {
  id                 String        @id @default(uuid())
  fullName           String
  email              String        @unique
  phone              String?
  password           String
  nationality        String
  role               UserRole
  visitorType        VisitorType?
  profileImage       String?
  arrivalDate        DateTime?
  departureDate      DateTime?
  defaultLanguage    String?
  inAppNotifications Boolean       @default(true)
  emailNotifications Boolean       @default(true)
  currentRegionId    String?
  currentRegion      Region?       @relation(fields: [currentRegionId], references: [id])
  guideProfile         GuideProfile?
  reviews              Review[]
  bookings             Booking[]
  wallet               Wallet?
  walletTransactions   WalletTransaction[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([currentRegionId])
}

model GuideProfile {
  id            String         @id @default(uuid())
  userId        String         @unique
  user          User           @relation(fields: [userId], references: [id])
  guideType     GuideType
  companyName   String?
  languages     String[]
  numberOfTours Int            @default(0)
  reviews       Review[]
  vehicles      GuideVehicle[]
  bookings      Booking[]
}

model Region {
  id        String     @id @default(uuid())
  name      String
  users     User[]
  tourTypes TourType[]
}

model TourType {
  id       String    @id @default(uuid())
  regionId String
  region   Region    @relation(fields: [regionId], references: [id])
  name     String
  packages Package[]

  @@index([regionId])
}

model Package {
  id            String         @id @default(uuid())
  tourTypeId    String
  tourType      TourType       @relation(fields: [tourTypeId], references: [id])
  name          String
  description   String
  durationHours Int
  price         Decimal        @db.Decimal(12, 2)
  tours         Json?
  media         PackageMedia[]
  reviews       Review[]
  bookings      Booking[]
  createdAt     DateTime       @default(now())

  @@index([tourTypeId])
}

model PackageMedia {
  id        String    @id @default(uuid())
  packageId String
  package   Package   @relation(fields: [packageId], references: [id])
  url       String
  type      MediaType

  @@index([packageId])
}

model Vehicle {
  id           String         @id @default(uuid())
  name         String
  icon         String?
  seats        Int
  pricePerHour Decimal        @db.Decimal(12, 2)
  pricePerDay  Decimal        @db.Decimal(12, 2)
  guides       GuideVehicle[]
  bookings     Booking[]
}

model GuideVehicle {
  guideId   String
  vehicleId String
  guide     GuideProfile @relation(fields: [guideId], references: [id])
  vehicle   Vehicle      @relation(fields: [vehicleId], references: [id])

  @@id([guideId, vehicleId])
  @@index([vehicleId])
}

model Review {
  id         String        @id @default(uuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id])
  guideId    String?
  guide      GuideProfile? @relation(fields: [guideId], references: [id])
  packageId  String?
  package    Package?      @relation(fields: [packageId], references: [id])
  message    String?
  starRating Int
  createdAt  DateTime      @default(now())

  @@index([userId])
  @@index([guideId])
  @@index([packageId])
}

model Booking {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  packageId      String
  package        Package      @relation(fields: [packageId], references: [id])
  vehicleId      String
  vehicle        Vehicle      @relation(fields: [vehicleId], references: [id])
  guideId        String
  guide          GuideProfile @relation(fields: [guideId], references: [id])
  scheduleDate   DateTime
  pickupLocation String
  totalDue       Decimal              @db.Decimal(12, 2)
  payment        Payment?
  walletEntries  WalletTransaction[]
  createdAt      DateTime             @default(now())

  @@index([userId])
  @@index([packageId])
  @@index([vehicleId])
  @@index([guideId])
}

/// Per-user balance kept in integer cents. A wallet is created lazily on
/// first read for a user that doesn't have one.
model Wallet {
  id           String              @id @default(cuid())
  userId       String              @unique
  balanceCents Int                 @default(0)
  currency     String              @default("USD")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
}

model WalletTransaction {
  id             String   @id @default(cuid())
  walletId       String?
  kind           String?
  amountCents    Int?
  currency       String   @default("USD")
  bookingId      String?
  externalRef    String?
  notes          String?
  createdAt      DateTime @default(now())
  cardToken      String?
  method         String?
  rwfAmount      Float?
  sourceAmount   Float?
  sourceCurrency String?
  status         String   @default("pending")
  userId         String?
  wallet         Wallet?  @relation(fields: [walletId], references: [id], onDelete: Cascade)
  booking        Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user           User?    @relation(fields: [userId], references: [id])

  @@index([walletId])
  @@index([bookingId])
  @@index([userId])
}

model Payment {
  id             String        @id @default(uuid())
  bookingId      String        @unique
  booking        Booking       @relation(fields: [bookingId], references: [id])
  amount         Decimal       @db.Decimal(12, 2)
  status         PaymentStatus
  paymentMethod  PaymentMethod
  transactionRef String?
  createdAt      DateTime      @default(now())
}
